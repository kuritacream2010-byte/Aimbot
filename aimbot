
-- Mobile NPC Aim Assist
-- Roblox Studio / LocalScript
-- Works with NPCs tagged "AimTarget"

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local AIM_RADIUS = 150
local AIM_SMOOTHNESS = 0.15
local aiming = false
local currentTarget = nil

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "MobileAimGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(100, 55)
button.Position = UDim2.new(1, -120, 0.65, 0)
button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
button.TextColor3 = Color3.new(1, 1, 1)
button.Text = "AIM: OFF"
button.TextScaled = true
button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = button

button.Activated:Connect(function()
    aiming = not aiming
    button.Text = aiming and "AIM: ON" or "AIM: OFF"
    button.BackgroundColor3 = aiming
        and Color3.fromRGB(35, 130, 70)
        or Color3.fromRGB(35, 35, 35)

    if not aiming then
        currentTarget = nil
    end
end)

-- Find nearest tagged NPC
local function getTarget()
    local closest = nil
    local shortest = AIM_RADIUS

    for _, npc in ipairs(CollectionService:GetTagged("AimTarget")) do
        if npc:IsA("Model") and npc ~= player.Character then
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            local head = npc:FindFirstChild("Head")

            if humanoid and head and humanoid.Health > 0 then
                local screenPos, visible =
                    camera:WorldToViewportPoint(head.Position)

                if visible then
                    local center = camera.ViewportSize / 2
                    local distance = (
                        Vector2.new(screenPos.X, screenPos.Y)
                        - center
                    ).Magnitude

                    if distance < shortest then
                        shortest = distance
                        closest = head
                    end
                end
            end
        end
	    end

    return closest
end

-- Aim camera toward target
RunService.RenderStepped:Connect(function()
    if not aiming then return end

    currentTarget = getTarget()

    if currentTarget then
        local desired = CFrame.lookAt(
            camera.CFrame.Position,
            currentTarget.Position
        )

        camera.CFrame = camera.CFrame:Lerp(
            desired,
            AIM_SMOOTHNESS
        )
    end
end)